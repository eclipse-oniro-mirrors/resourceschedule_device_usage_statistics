import("//build/config/features.gni")
import("//build/test.gni")
import("../../../device_usage_statistics.gni")

module_output_path = "device_usage_statistics/device_usage_statistics"

config("module_private_config") {
  include_dirs = [
    "${usage_statistics_path}/interfaces/innerkits/include",
    "${usage_statistics_path}/services/common/include",
    "${usage_statistics_path}/services/packageusage/include",
    "${usage_statistics_path}/services/packagegroup/include",
    "${usage_statistics_path}/utils/include",
  ]
}

ohos_fuzztest("BundleActiveHighFrequencyPeriodFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file =
      "${usage_statistics_path}/test/fuzztest/bundleactivehighfrequencyperiod_fuzzer"
  configs = [ ":module_private_config" ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [ "bundleactivehighfrequencyperiod_fuzzer.cpp" ]

  public_deps = [ "${usage_statistics_path}:usagestatsinner" ]
  external_deps = [
    "hilog:libhilog",
    "ipc:ipc_single",
  ]
}

group("fuzztest") {
  testonly = true
  deps = [ ":BundleActiveHighFrequencyPeriodFuzzTest" ]
}
